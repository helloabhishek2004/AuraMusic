{
  "name": "AuraMusic — Free, Ad-Free Offline Android Music Player",
  "short_name": "AuraMusic",
  "description": "AuraMusic is a free, ad-free Android music player featuring offline downloads, local audio playback, synced lyrics, and native Media3 sound fidelity.",
